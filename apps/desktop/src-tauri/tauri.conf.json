{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyGlossMusic",
  "version": "0.1.5",
  "identifier": "co.testiando.myglossmusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyGlossMusic",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/yt-dlp"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jonatan-testiando/MyGlossMusic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOEY3MDY3RDYxRTk2RTcKUldUbmxoN1daM0NQeTFkaW1KYzAyb3AvNzg5TklRaXVsOU5sdUlZUDllY2pwOXZieVEvNVhVMWEK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
